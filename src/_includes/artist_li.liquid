<li class="desktop">
  <a class="artist-link" data-slug="{{ post.slug }}">
    <div>
      <span>{{ post.title }}{% if post.data.country %}</span><span class="country">({{ post.data.country }}){% endif %}</span>
    </div>
    <div style="position: relative;">
      <img src="{{ post.data.img }}">
      {% comment %}Find the scheduled time for this artist{% endcomment %}
      {% for event in site.data.events %}
        {% for day in event.days %}
          {% for schedule_item in day.schedule %}
            {% if schedule_item.artist == post.title %}
              {% assign day_abbr = "THU" %}
              {% if day.name == "Friday" %}
                {% assign day_abbr = "FRI" %}
              {% elsif day.name == "Saturday" %}
                {% assign day_abbr = "SAT" %}
              {% endif %}
              {% assign font_color = "#ffffff" %}
              {% if post.title == "Finlay Shakespeare" or post.title == "Heidemann / Mingot / Klint" %}
                {% assign font_color = "#000000" %}
              {% endif %}
              <span style="
                font-size: 14px;
                position: absolute;
                top: 5px;
                right: 5px;
                line-height: 12px;
                font-family: 'public';
                color: {{ font_color }};
              ">{{ day_abbr }}<br>{{ schedule_item.time }}</span>
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endfor %}
    </div>
  </a>
</li>
