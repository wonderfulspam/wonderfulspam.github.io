<li class="desktop">
  <a class="artist-link" data-slug="{{ post.slug }}">
    <div>
      <span>{{ post.title }}{% if post.data.country %}</span><span class="country">({{ post.data.country }}){% endif %}</span>
    </div>
    <div class="artist-image-wrapper">
      <img src="{{ post.data.img }}">
      {% include "get_artist_schedule.liquid" artist_title=post.title %}
      {% if artist_day != "" %}
      <span class="artist-time-overlay{% if post.title == 'Finlay Shakespeare' or post.title == 'Heidemann / Mingot / Klint' %} light-image{% endif %}">{{ artist_day }}<br>{{ artist_time }}</span>
      {% endif %}
    </div>
  </a>
</li>
