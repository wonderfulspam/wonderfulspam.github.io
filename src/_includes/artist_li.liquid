<li class="desktop">
  <a class="artist-link" data-slug="{{ post.slug }}">
    <div>
      <span>{{ post.title }}{% if post.data.country %}</span><span class="country">({{ post.data.country }}){% endif %}</span>
    </div>
    <img src="{{ post.data.img }}">
    {% comment %} Add scheduled time overlay {% endcomment %}
    {% for event in site.data.events %}
      {% for day in event.days %}
        {% for schedule_item in day.schedule %}
          {% if schedule_item.artist == post.title %}
            {% assign day_upper = day.name | upcase %}
            {% assign text_color = "white" %}
            {% if post.title == "Finlay Shakespeare" or post.title == "Heidemann / Mingot / Klint" %}
              {% assign text_color = "black" %}
            {% endif %}
            <span style="font-size: 14px; position: absolute; top: 5px; right: 5px; line-height: 12px; font-family: 'public'; color: {{ text_color }}; z-index: 10; text-align: right;">{{ day_upper }}<br>{{ schedule_item.time }}</span>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
  </a>
</li>
