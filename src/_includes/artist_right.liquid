<div id="{{ post.slug }}">
    <div class="artistcontent">
    {% if post.data.img %}
    <div class="artist-image-container">
        <h2>{{ post.title }}{% if post.data.country %}<span class="country">({{ post.data.country }})</span>{% endif %}</h2>
        <div style="position: relative; display: inline-block;">
            <img src="{{ post.data.img }}">
            {% include "get_artist_schedule.liquid", artist_title: post.title %}
            {% if artist_day != "" and artist_time != "" %}
              {% assign light_images = "Finlay Shakespeare,Heidemann / Mingot / Klint" | split: "," %}
              {% assign is_light = false %}
              {% for light_artist in light_images %}
                {% if post.title == light_artist %}
                  {% assign is_light = true %}
                {% endif %}
              {% endfor %}
              <span class="artist-time-overlay-detail{% if is_light %} light-image{% endif %}">{{ artist_day }}<br>{{ artist_time }}</span>
            {% endif %}
        </div>
</div>
{% endif %}
{{ post.content }}
<a class="back-button bottom-back-button">← BACK</a>
</div>
</div>