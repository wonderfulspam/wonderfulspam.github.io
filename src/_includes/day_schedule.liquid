<div class="day-column">
  <div class="dayheader">
    <h3>{{ day.name }}</h3>
  </div>

  {% assign has_pre_doors = false %}
  {% assign past_doors = false %}
  {% for slot in day.schedule %}
    {% if slot.time > day.doors %}{% assign past_doors = true %}{% endif %}
    {% unless past_doors %}{% assign has_pre_doors = true %}{% endunless %}
  {% endfor %}

  {% if has_pre_doors %}
  <div class="dayheader day-subheader">
    <h3>Workshops</h3>
  </div>
  <div class="day pre-doors">
  <table>
    {% assign past_doors = false %}
    {% for slot in day.schedule %}
      {% if slot.time > day.doors %}{% assign past_doors = true %}{% endif %}
      {% unless past_doors %}
      {% include "schedule_row.liquid" %}
      {% endunless %}
    {% endfor %}
  </table>
  </div>
  {% endif %}

  <div class="dayheader day-subheader">
    <h3>Schedule</h3>
  </div>
  <div class="day">
  <table>
    <tr class="doors"><td>{{ day.doors }}</td><td>Doors open</td></tr>
    {% assign past_doors = false %}
    {% for slot in day.schedule %}
      {% if slot.time > day.doors %}{% assign past_doors = true %}{% endif %}
      {% if past_doors %}
      {% include "schedule_row.liquid" %}
      {% endif %}
    {% endfor %}
  </table>
  </div>

  <div class="day">
  <table>
    <tr class="dj">
      <td>DJ</td>
      {% assign dj_artist = collections.posts.pages | where: "title", day.dj | first %}
      {% if dj_artist %}
      <td>
        <a class="artist-link" data-slug="{{ dj_artist.slug }}">{{ dj_artist.title }}</a>
      </td>
      {% else %}
      <td>{{ day.dj }}</td>
      {% endif %}
    </tr>
  </table>
  </div>

</div>
