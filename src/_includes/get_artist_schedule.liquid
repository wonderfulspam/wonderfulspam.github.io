{% comment %}
This include searches for an artist's scheduled time in the events data.
Usage: {% include "get_artist_schedule.liquid", artist_title: post.title %}
Returns: artist_day (THU/FRI/SAT) and artist_time (HH:MM)
{% endcomment %}

{% assign artist_day = "" %}
{% assign artist_time = "" %}

{% for event in site.data.events %}
  {% for day in event.days %}
    {% for slot in day.schedule %}
      {% if slot.artist == artist_title %}
        {% assign artist_time = slot.time %}
        {% if day.name == "Thursday" %}
          {% assign artist_day = "THU" %}
        {% elsif day.name == "Friday" %}
          {% assign artist_day = "FRI" %}
        {% elsif day.name == "Saturday" %}
          {% assign artist_day = "SAT" %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endfor %}
