---
title: Experience
layout: default.liquid
permalink: /experience
data:
  classname: lineup
---

<div id="art-list">
  <div class="event">
    <ul>
    {% for art in site.data.art %}
      {% if art.section %}
        <li class="section-header"><h3>{{ art.section }}</h3></li>
      {% else %}
        {% include "art_li.liquid" %}
      {% endif %}
    {% endfor %}
    </ul>
  </div>
</div>
<div id="artist-detail" style="display: none;">
  <div id="artist-detail-content">
    <a id="back-to-art" class="back-button">← BACK</a>
  </div>
</div>
{% include "art_hidden.liquid" %}
<script type="text/javascript">
  addArtistDetailHandler(".artist-link");
</script>
