---
title: Lineup
layout: default.liquid
permalink: /lineup
---



<div id="lineup-list">
{% assign events = collections.posts.pages | map: "categories" | sort | uniq %}
{% for event_name in events %}
  {% include "assign_event_data.liquid" %}
  <div class="event">
   {% comment %}
 <h3>{{ event_data.name }}</h3>
    {% endcomment %}
    <ul>
    {% for post in artists %}
      {% include "artist_li.liquid" %}
    {% endfor %}
    </ul>

  </div>
{% endfor %}
</div>
<div id="artist-detail" style="display: none;">
  <div id="artist-detail-content">
    <a id="back-to-lineup" class="back-button">← BACK</a>
  </div>
</div>
{% include "artists_hidden.liquid" %}
<script type="text/javascript">
  addArtistDetailHandler(".artist-link");
</script>